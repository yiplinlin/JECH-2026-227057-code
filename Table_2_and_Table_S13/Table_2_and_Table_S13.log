. global s13_post_results `R'

. global s13_post_intervals `C'

. capture program drop report_s13

. program define report_s13
  1.     args panel outcome wtype wt scale expectedn expectedb
  2.     tempname n g b se df pc lo hi delta bb ss ci wp nr nf dd null ci_low ci_high orig endpoint_error endpoint_p
  3.     tempvar sample
  4.     scalar `n'=e(N)
  5.     scalar `g'=e(N_clust)
  6.     scalar `b'=_b[exposed_before15]
  7.     scalar `se'=_se[exposed_before15]
  8.     scalar `df'=e(df_r)
  9.     scalar `pc'=2*ttail(`df',abs(`b'/`se'))
 10.     scalar `lo'=`b'-invttail(`df',.025)*`se'
 11.     scalar `hi'=`b'+invttail(`df',.025)*`se'
 12.     scalar `delta'=`b'-`expectedb'
 13.     assert `n'==`expectedn'
 14.     assert `g'==16
 15.     assert abs(`delta')<.0000005
 16.     gen byte `sample'=e(sample)
 17.     estimates store `orig'
 18.     quietly regress `outcome' exposed_before15 i.survey_id i.cohort_id [`wtype'=`wt'] if `sample', vce(cluster country_id)
 19.     assert e(sample)==`sample'
 20.     scalar `bb'=_b[exposed_before15]-`b'
 21.     scalar `ss'=_se[exposed_before15]-`se'
 22.     assert abs(`bb')<.0000001
 23.     assert abs(`ss')<.0000001
 24.     estimates restore `orig'
 25.     estimates drop `orig'
 26.     display "S13_MODEL_START PANEL=`panel' OUTCOME=`outcome' N=" `n' " CLUSTERS=" `g'
 27.     display "PREVIOUS_POINT_DIFFERENCE=" %20.12g `delta'
 28.     display "SAME_SAMPLE_FE_EQUIVALENCE_B=" %20.12g `bb' " SE=" %20.12g `ss'
 29.     boottest exposed_before15, cluster(country_id) reps(5000) seed(20260708) weighttype(rademacher) level(95) nograph svmat
 30.     return list
 31.     scalar `wp'=r(p)
 32.     scalar `nr'=r(reps)
 33.     scalar `null'=r(null)
 34.     matrix `dd'=r(dist)
 35.     matrix `ci'=r(CI)
 36.     mata: st_numscalar("`nf'",sum(st_matrix("`dd'"):<.))
 37.     assert `nr'==5000
 38.     assert `nf'==5000
 39.     assert `null'==1
 40.     assert inrange(`wp',0,1)
 41.     local parts=rowsof(`ci')
 42.     assert `parts'>=1
 43.     scalar `endpoint_error'=0
 44.     forvalues j=1/`parts' {
 45.         post $s13_post_intervals ("`panel'") ("`outcome'") (`j') (`scale'*`ci'[`j',1]) (`scale'*`ci'[`j',2])
 46.         forvalues side=1/2 {
 47.             if `ci'[`j',`side']<. {
 48.                 local boundary: display %24.17g `ci'[`j',`side']
 49.                 quietly boottest exposed_before15=`boundary', cluster(country_id) reps(5000) seed(20260708) weighttype(rademacher) noci nograph
 50.                 scalar `endpoint_p'=r(p)
 51.                 scalar `endpoint_error'=max(`endpoint_error',abs(`endpoint_p'-.05))
 52.                 assert abs(`endpoint_p'-.05)<.003
 53.                 display "S13_CI_ENDPOINT_CHECK OUTCOME=`outcome' PART=`j' SIDE=`side' NULL=" %20.12g `ci'[`j',`side'] " P=" %10.6f `endpoint_p'
 54.             }
 55.         }
 56.     }
 57.     scalar `ci_low'=.
 58.     scalar `ci_high'=.
 59.     if `parts'==1 {
 60.         scalar `ci_low'=`scale'*`ci'[1,1]
 61.         scalar `ci_high'=`scale'*`ci'[1,2]
 62.     }
 63.     local unit "per 1000 women"
 64.     if "`panel'"=="A" local unit "percentage points"
 65.     post $s13_post_results ("`panel'") ("`outcome'") ("`unit'") (`n') (`g') (`scale'*`b') (`scale'*`se') (`scale'*`lo') (`scale'*`hi') (`pc') (`wp') (`nr') (`nf') (`parts') (`ci_low') (`ci_high') (`delta') (`bb') (`ss') (`endpoint_error')
 66.     display "S13_MODEL_COMPLETE PANEL=`panel' OUTCOME=`outcome' ESTIMATE=" %16.9f (`scale'*`b') " WILD_P=" %10.6f `wp' " WILD_CI_LOW=" %16.9f `ci_low' " WILD_CI_HIGH=" %16.9f `ci_high' " CI_PARTS=`parts' VALID_REPS=" `nf'
 67. end

