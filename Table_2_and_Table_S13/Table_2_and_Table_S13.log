. program define report_model
  1. args outcome spec
  2. tempname n g b se df p lo hi ci wp nr nf dist
  3. scalar `n'=e(N)
  4. scalar `g'=e(N_clust)
  5. scalar `b'=_b[exposed_before15]
  6. scalar `se'=_se[exposed_before15]
  7. scalar `df'=e(df_r)
  8. assert `se'>0 & `se'<.
  9. scalar `p'=2*ttail(`df',abs(`b'/`se'))
 10. scalar `lo'=`b'-invttail(`df',.025)*`se'
 11. scalar `hi'=`b'+invttail(`df',.025)*`se'
 12. display "MODEL_START OUTCOME=`outcome' SPEC=`spec' N=" `n' " CLUSTERS=" `g'
 13. boottest exposed_before15, cluster(country_id) reps($r2reps) seed(20260708) weighttype(rademacher) nograph svmat
 14. return list
 15. scalar `wp'=r(p)
 16. scalar `nr'=r(reps)
 17. matrix `dist'=r(dist)
 18. mata: st_numscalar("`nf'", sum(st_matrix("`dist'"):<.))
 19. matrix `ci'=r(CI)
 20. local parts=rowsof(`ci')
 21. assert `nr'==$r2reps
 22. assert `nf'==$r2reps
 23. forvalues j=1/`parts' {
 24. post $r2ci ("`outcome'") ("`spec'") (`j') (`ci'[`j',1]) (`ci'[`j',2])
 25. }
 26. post $r2res ("`outcome'") ("`spec'") (`n') (`g') (`b') (`se') (`lo') (`hi') (`p') (`wp') (`nr') (`nf') (`parts')
 27. display "MODEL_COMPLETE OUTCOME=`outcome' SPEC=`spec' B=" %16.10f `b' " P_WCB=" %12.8f `wp'
 28. end

